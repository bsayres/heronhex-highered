# Free key from https://api.data.gov/signup . Copy to .env (gitignored). Never commit real keys.
COLLEGE_SCORECARD_API_KEY=
# Optional: where bulk downloads are cached (default ~/.cache/highered-mcps)
# HIGHERED_MCPS_CACHE=

# Free key from https://api.data.gov/signup (used by highered-risk get_audit_findings)
FAC_API_KEY=

# Your email address. BLS requires a contact in the User-Agent for its projections file; sent only to bls.gov (highered-labor-market)
HIGHERED_MCPS_CONTACT=

# Optional, for opt-in live tests (HIGHERED_LIVE=1) and fixture recording: pick any institution
# HIGHERED_LIVE_NAME=
# HIGHERED_LIVE_UNITID=
# HIGHERED_LIVE_OPEID=
# HIGHERED_LIVE_EIN=
# HIGHERED_LIVE_UEI=
