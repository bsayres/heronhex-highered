{
  "mcpServers": {
    "highered-institutions": {
      "command": "uvx",
      "args": [
        "--from",
        "heronhex-institutions==0.1.1",
        "highered-institutions"
      ],
      "env": {
        "COLLEGE_SCORECARD_API_KEY": "${user_config.scorecard_api_key}"
      }
    },
    "highered-risk": {
      "command": "uvx",
      "args": [
        "--from",
        "heronhex-risk==0.1.1",
        "highered-risk"
      ],
      "env": {
        "FAC_API_KEY": "${user_config.fac_api_key}"
      }
    },
    "highered-accreditation": {
      "command": "uvx",
      "args": [
        "--from",
        "heronhex-accreditation==0.1.1",
        "highered-accreditation"
      ]
    },
    "highered-funding": {
      "command": "uvx",
      "args": [
        "--from",
        "heronhex-funding==0.1.1",
        "highered-funding"
      ]
    },
    "highered-labor-market": {
      "command": "uvx",
      "args": [
        "--from",
        "heronhex-labor==0.1.1",
        "highered-labor-market"
      ],
      "env": {
        "COLLEGE_SCORECARD_API_KEY": "${user_config.scorecard_api_key}",
        "HIGHERED_MCPS_CONTACT": "${user_config.contact_email}"
      }
    }
  }
}
