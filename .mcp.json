{
  "mcpServers": {
    "highered-institutions": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--no-dev",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/servers/highered-institutions",
        "highered-institutions"
      ],
      "env": {
        "COLLEGE_SCORECARD_API_KEY": "${user_config.scorecard_api_key}"
      }
    },
    "highered-risk": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--no-dev",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/servers/highered-risk",
        "highered-risk"
      ],
      "env": {
        "FAC_API_KEY": "${user_config.fac_api_key}"
      }
    },
    "highered-accreditation": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--no-dev",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/servers/highered-accreditation",
        "highered-accreditation"
      ]
    },
    "highered-funding": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--no-dev",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/servers/highered-funding",
        "highered-funding"
      ]
    },
    "highered-labor-market": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--no-dev",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/servers/highered-labor-market",
        "highered-labor-market"
      ],
      "env": {
        "COLLEGE_SCORECARD_API_KEY": "${user_config.scorecard_api_key}",
        "HIGHERED_MCPS_CONTACT": "${user_config.contact_email}"
      }
    }
  }
}
